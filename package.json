{
  "name": "stargazer-agent",
  "version": "0.1.0",
  "description": "A minimal TypeScript chat agent with CLI and web workspace",
  "type": "module",
  "private": true,
  "bin": {
    "stargazer-agent": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/web.js",
    "web": "npm run build:web && tsx src/web.ts",
    "web:dev": "concurrently --kill-others-on-fail --names api,web \"tsx watch src/web.ts\" \"vite --config web/vite.config.ts\"",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint src test web/src web/*.ts vitest.config.ts",
    "test": "npm run test:server && npm run test:web",
    "test:server": "vitest run --config vitest.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "vue-tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.4",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.21",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  }
}
