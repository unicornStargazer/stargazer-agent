{
  "name": "stargazer-agent",
  "version": "0.1.0",
  "description": "A Python chat agent with a Vue and TypeScript web workspace",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "npm run web:dev",
    "start": "npm run start:server",
    "start:server": "uv run --project backend --locked python -m dokkan_agent.main",
    "web": "npm run build:web && npm start",
    "web:dev": "concurrently --kill-others-on-fail --names api,web \"npm run start:server\" \"vite --config web/vite.config.ts\"",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint web/src web/*.ts",
    "test": "npm run test:web",
    "test:web": "vitest run --config web/vitest.config.ts",
    "typecheck": "npm run typecheck:web",
    "typecheck:web": "vue-tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.4",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.21",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  }
}
