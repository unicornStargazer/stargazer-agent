{
  "name": "stargazer-agent",
  "version": "0.1.0",
  "description": "A minimal TypeScript chat agent",
  "type": "module",
  "private": true,
  "bin": {
    "stargazer-agent": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
